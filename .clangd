CompileFlags:
  CompilationDatabase: build

  # Remove GCC/Xtensa-specific flags unsupported by clangd
  Remove:
    - -mno-serialize-volatile
    - -mtext-section-literals
    - -mlongcalls
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitflags
    - -mno-allow-o32-direct-calls
    - -mno-allow-o32-irect-calls
    - -mtarget-align
    - -mno-target-align
    - -fno-jump-tables

  # ESP-IDF header search paths
  Add:
    # --- SDK configuration macros (from sdkconfig.defaults) ---
    - -DCONFIG_IDF_TARGET_ESP32S3
    - -DCONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
    - -DCONFIG_COMPILER_OPTIMIZATION_PERF
    - -DCONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240
    - -DCONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
    - -DCONFIG_FREERTOS_HZ=1000
    # --- Core components ---
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_common/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_system/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_system/port/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_hw_support/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_hw_support/port/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_rom/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_rom/esp32s3/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/soc/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/soc/esp32s3/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/hal/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/hal/esp32s3/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_mm/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_partition/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_app_format/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_timer/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_pm/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_ringbuf/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_eth/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/esp_event/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/heap/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/heap/tlsf/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/log/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/newlib/include
    - -isystem/Users/sharp/.espressif/v6.0.2/esp-idf/components/pthread/include
